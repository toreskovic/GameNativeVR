#version 450
#extension GL_GOOGLE_include_directive : require
#include "alignment.glsl"
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D oldColor;
layout(binding=1) uniform sampler2D newColor;
layout(binding=2,rgba8) writeonly uniform image2D outputImage;
#ifdef FILTERED_FLOW
#define FLOW_SAMPLER sampler2D
#else
#define FLOW_SAMPLER isampler2D
#endif
layout(binding=3) uniform FLOW_SAMPLER forwardFlow;
layout(binding=4) uniform FLOW_SAMPLER backwardFlow;

vec2 flow(FLOW_SAMPLER tex,vec2 uv) {
#ifdef FILTERED_FLOW
    // Preserve the 8x8 block-grid coordinates even for partial edge blocks.
    vec2 gridUv=uv*vec2(p.size.xy)/(8.0*vec2(textureSize(tex,0)));
    return textureLod(tex,gridUv,0).xy/vec2(p.size.xy);
#else
    // Vectors are luma-pixel displacements on an 8x8 block grid, not output pixels.
    vec2 q=uv*vec2(p.size.xy)/8.0-0.5, f=fract(q);
    ivec2 a=ivec2(floor(q)),hi=textureSize(tex,0)-1;
    vec2 v00=vec2(texelFetch(tex,clamp(a,ivec2(0),hi),0).xy);
    vec2 v10=vec2(texelFetch(tex,clamp(a+ivec2(1,0),ivec2(0),hi),0).xy);
    vec2 v01=vec2(texelFetch(tex,clamp(a+ivec2(0,1),ivec2(0),hi),0).xy);
    vec2 v11=vec2(texelFetch(tex,clamp(a+ivec2(1),ivec2(0),hi),0).xy);
    return mix(mix(v00,v10,f.x),mix(v01,v11,f.x),f.y)/vec2(p.size.xy);
#endif
}
bool inside(vec2 uv) { return all(greaterThanEqual(uv,vec2(0))) && all(lessThanEqual(uv,vec2(1))); }
void main() {
    ivec2 pos=ivec2(gl_GlobalInvocationID.xy), extent=imageSize(outputImage);
    if(any(greaterThanEqual(pos,extent))) return;
    vec2 uv=(vec2(pos)+0.5)/vec2(extent);
    vec2 a=uv-0.5*flow(forwardFlow,uv),b=uv-0.5*flow(backwardFlow,uv);
    // One inverse-warp estimate; retain consistency checks at the warped positions.
    vec2 f=flow(forwardFlow,a),r=flow(backwardFlow,b);
    vec4 ca=textureLod(oldColor,rawUv(a,false),0),cb=textureLod(newColor,rawUv(b,true),0);
    float error=length((f+r)*vec2(p.size.xy));
    float colorError=max(max(abs(ca.r-cb.r),abs(ca.g-cb.g)),abs(ca.b-cb.b));
    float confidence=(1.0-smoothstep(1.0,3.0,error))*(1.0-smoothstep(0.08,0.25,colorError));
    if(!inside(a)||!inside(b)) confidence=0.0;
    // Disocclusion/scene-change disagreement uses the newer real image, avoiding
    // a double-exposed crossfade. This is a conservative color-only heuristic.
    vec4 real=textureLod(newColor,rawUv(uv,true),0);
    imageStore(outputImage,pos,mix(real,mix(ca,cb,0.5),confidence));
}
